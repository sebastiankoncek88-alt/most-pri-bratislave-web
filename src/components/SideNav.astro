---
import { sections, url } from '../data/site';
import { sectionTree } from '../lib/content';
interface Props { section: string; currentId?: string; currentHref?: string }
const { section, currentId, currentHref } = Astro.props;
const meta = sections.find((s) => s.id === section);
const groups = await sectionTree(section);
const isCur = (i: { id: string; href: string }) => i.id === currentId || i.href === currentHref;
const isOpen = (i: { id: string; href: string }) => isCur(i) || (currentId ?? '').startsWith(i.id + '/');
---
<nav class="side-nav" aria-label={`Navigácia v sekcii ${meta?.title ?? 'Kontakt'}`}>
  <h2><a href={url(`/${section}/`)}>{meta?.title ?? 'Kontakt'}</a></h2>
  {[...groups.entries()].map(([g, items]) => (
    <>
      {groups.size > 1 && <h3>{g}</h3>}
      <ul>
        {items.map((top) => (
          <li>
            <a class="sn" href={url(top.href)} aria-current={isCur(top) ? 'page' : undefined}>{top.title}{top.href.startsWith('http') && <span class="ext" aria-label=" (externý web)"> ↗</span>}</a>
            {top.children.length > 0 && isOpen(top) && (
              <ul>
                {top.children.map((c) => (
                  <li>
                    <a class="sn" href={url(c.href)} aria-current={isCur(c) ? 'page' : undefined}>{c.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </>
  ))}
</nav>

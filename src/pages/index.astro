---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EventList from '../components/EventList.astro';
import { quickLinks, obec, url } from '../data/site';
import { allNews, boardItems, newsUrl, fmtDate } from '../lib/content';
import gallery from '../data/gallery.json';
import podnety from '../data/podnety.json';
import { podnetTopic } from '../lib/topics';

const all = await allNews();
const rows = all.slice(0, 20);
const flash = [...all].filter((n) => n.data.time).slice(0, 4).concat(all.filter((n) => !n.data.time)).slice(0, 4);
const tone = (c: string) => ({ 'Upozornenie': 'warn', 'Doprava a stavby': 'traffic', 'Odpady': 'waste', 'Kultúra a šport': 'culture', 'Voľby': 'civic', 'Obecný úrad': 'civic' } as Record<string, string>)[c] ?? 'default';
const catIcon = (c: string) => ({ 'Upozornenie': 'triangle-alert', 'Doprava a stavby': 'construction', 'Odpady': 'recycle', 'Kultúra a šport': 'party-popper', 'Voľby': 'vote', 'Obecný úrad': 'landmark' } as Record<string, string>)[c] ?? 'megaphone';
const recent = Date.now() - 21 * 24 * 3600 * 1000; // staršie upozornenia už spravidla neplatia
const warnings = all.filter((n) => ['Upozornenie', 'Doprava a stavby'].includes(n.data.category) && n.data.date.getTime() >= recent).slice(0, 3);
const photos = gallery.slice(0, 4);
const board = await boardItems(5);
---
<Base current="home">
  <section class="hero" style={`--hero-erb: url(${url('/erb-512-v2.png')})`}>
    <svg class="hero-flight" viewBox="0 0 1200 420" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
      <path d="M1250 40 C 1000 30, 820 150, 700 230 S 470 330, 300 318" fill="none" stroke="#f2dc86" stroke-width="2" stroke-dasharray="1 9" stroke-linecap="round" opacity="0.55" />
      <circle cx="300" cy="318" r="5" fill="#e3bd2f" opacity="0.9" />
      <circle cx="300" cy="318" r="14" fill="#f2dc86" opacity="0.12" />
    </svg>
    <div class="container hero-inner">
      <h1>Čo potrebujete vybaviť?</h1>
      <p class="hero-lead">Napíšte, čo hľadáte, alebo vyberte z najčastejších vecí nižšie.</p>
      <form class="hero-search" action={url('/vyhladavanie/')} role="search">
        <label for="q" class="sr-only">Hľadať na webe obce</label>
        <input id="q" name="q" type="search" placeholder="Čo hľadáte? Napr. vývoz odpadu, trvalý pobyt…" autocomplete="off" />
        <button type="submit"><Icon name="search" size={20} /><span>Hľadať</span></button>
      </form>
    </div>
  </section>

  <section class="quick" aria-labelledby="quick-title">
    <div class="container">
      <h2 id="quick-title" class="quick-title">Najčastejšie</h2>
      <ul class="quick-grid">
        {quickLinks.map((q) => (
          <li>
            <a class="quick-card" href={url(q.href)}>
              <span class="quick-icon"><Icon name={q.icon} size={22} /></span>
              <span><strong>{q.title}</strong><span class="q-text">{q.text}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-section" aria-label="Novinky a rýchle správy">
    <div class="container home-grid">
      <div>
        <div class="section-head">
          <h2>Novinky v obci</h2>
          <a class="link-arrow" href={url('/aktuality/')}>Všetky novinky <Icon name="arrow-right" size={18} /></a>
        </div>
        <ul class="news-rows">
          {rows.map((n) => (
            <li class={`news-row tone-${tone(n.data.category)}`}>
              {n.data.image
                ? <img class="nr-thumb" src={url(n.data.image)} alt="" loading="lazy" decoding="async" />
                : <span class="nr-thumb nr-thumb--icon" aria-hidden="true"><Icon name={catIcon(n.data.category)} size={26} /></span>}
              <span class="nr-body">
                <span class="nr-meta"><span class="tag">{n.data.category}</span> <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmtDate(n.data.date)}</time></span>
                <a href={url(newsUrl(n))}>{n.data.title}</a>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <aside>
        <section class="panel" aria-labelledby="quick-news-title">
          <h2 id="quick-news-title"><Icon name="megaphone" size={22} /> Rýchle správy</h2>
          <ol class="flash">
            {flash.map((n) => (
              <li>
                <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmtDate(n.data.date)}{n.data.time && ` o ${n.data.time.replace(/^0/, '')}`}</time>
                <a href={url(newsUrl(n))}>{n.data.title}</a>
                {n.data.excerpt && <p>{n.data.excerpt}</p>}
              </li>
            ))}
          </ol>
          <p class="panel-foot"><a class="link-arrow" href={url('/aktuality/')}>Všetky správy <Icon name="arrow-right" size={18} /></a></p>
        </section>
        <section class="panel panel--warn" aria-labelledby="warn-title">
          <h2 id="warn-title"><Icon name="triangle-alert" size={22} /> Na čo si dať pozor</h2>
          {warnings.length ? (
            <ul class="news-list">
              {warnings.map((n) => (
                <li><a href={url(newsUrl(n))}><time>{fmtDate(n.data.date)}</time><strong>{n.data.title}</strong></a></li>
              ))}
            </ul>
          ) : <p>Momentálne nie sú žiadne aktuálne upozornenia.</p>}
          <p class="panel-foot"><a class="link-arrow" href={url('/aktuality/upozornenia/')}>Všetky upozornenia <Icon name="arrow-right" size={18} /></a></p>
        </section>
      </aside>
    </div>
  </section>

  <section class="home-section home-section--tint" aria-label="Úradná tabuľa, podujatia a voľby">
    <div class="container trio">
      <section class="panel" aria-labelledby="board-title">
        <h2 id="board-title"><Icon name="clipboard-list" size={22} /> Úradná tabuľa</h2>
        <ul class="news-list">
          {board.map((b) => (
            <li><a href={b.href}><time>{b.date}</time><strong>{b.title}</strong></a></li>
          ))}
        </ul>
        <p class="panel-foot"><a class="link-arrow" href={url('/uradna-tabula/uradna-tabula/')}>Celá úradná tabuľa <Icon name="arrow-right" size={18} /></a></p>
      </section>
      <section class="panel" aria-labelledby="events-title">
        <h2 id="events-title"><Icon name="calendar-days" size={22} /> Najbližšie podujatia</h2>
        <EventList limit={5} />
        <p class="panel-foot"><a class="link-arrow" href={url('/aktuality/podujatia/')}>Kalendár podujatí <Icon name="arrow-right" size={18} /></a></p>
      </section>
      <section class="panel panel--vote" aria-labelledby="vote-title">
        <h2 id="vote-title"><Icon name="vote" size={22} /> Voľby a referendá</h2>
        <p>Kandidáti, volebné okrsky, oznámenia volebných komisií a dokumenty.</p>
        <ul class="vote-links">
          <li><a href={url('/uradna-tabula/volby-2026/')}><strong>Komunálne a krajské voľby 2026</strong><small>kandidáti, okrsky, oznámenia</small></a></li>
          <li><a href={url('/uradna-tabula/referendum-2026/')}><strong>Referendum 2026</strong><small>informácie a dokumenty</small></a></li>
          <li><a href={url('/uradna-tabula/volby/')}><strong>Archív volieb</strong><small>predchádzajúce voľby</small></a></li>
        </ul>
        <p class="panel-foot"><a class="link-arrow" href={url('/volby/')}>Ako voliť a prehľad <Icon name="arrow-right" size={18} /></a></p>
      </section>
    </div>
  </section>

  <section class="home-section" aria-labelledby="podnety-title">
    <div class="container">
      <div class="section-head">
        <h2 id="podnety-title">Podnety pre starostku</h2>
        <span class="head-links">
          <a class="link-arrow" href={url('/kontakt/podnety/')}>Všetky odpovede <Icon name="arrow-right" size={18} /></a>
          <a class="btn btn-primary btn-sm" href={url('/nahlasit-problem/')}><Icon name="message-square-warning" size={18} /> Poslať podnet</a>
        </span>
      </div>
      {podnety.stats && <p class="podnet-stat"><strong>{podnety.stats.solved.toLocaleString('sk-SK')}</strong> vyriešených podnetov, <strong>{podnety.stats.open}</strong> práve v riešení</p>}
      <ul class="podnet-cards">
        {podnety.items.slice(0, 4).map((p) => {
          const open = /rieš/i.test(p.status) && !/vyrieš/i.test(p.status);
          const t = podnetTopic(p.title);
          return (
            <li class={`podnet-card tone-${t.tone}`}>
              <span class="pc-img" aria-hidden="true"><Icon name={t.icon} size={40} /><small>{t.label}</small></span>
              <span class={`badge${open ? ' badge--open' : ''}`}><Icon name={open ? 'clock' : 'circle-check'} size={14} /> {p.status}</span>
              <a href={url(`/kontakt/podnety/#podnet-${p.id}`)}>{p.title}</a>
              {p.received && <small>{fmtDate(new Date(p.received + 'T12:00:00'))}</small>}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="home-section home-section--tint" aria-label="Odpady">
    <div class="container">
      <div class="waste-card">
        <span class="w-icon"><Icon name="recycle" size={32} /></span>
        <div>
          <h2>Kedy k vám prídu smetiari?</h2>
          <p>Harmonogram vývozu na rok 2026 pre všetky časti obce, zberné dni a pravidlá triedenia.</p>
          <div class="waste-links">
            <a href={url('/odpady/objemny-odpad/')}>Objemný odpad</a>
            <a href={url('/odpady/elektroodpad/')}>Elektroodpad</a>
            <a href={url('/odpady/konare-a-stromy/')}>Konáre</a>
            <a href={url('/odpady/reklamacia-vyvozu/')}>Nevyviezli vám smeti?</a>
          </div>
        </div>
        <a class="btn btn-green" href={url('/odpady/harmonogram/harmonogram-na-rok-2026/')}>Harmonogram 2026 <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>


  <section class="home-section home-section--tint" aria-labelledby="gallery-title">
    <div class="container">
      <div class="section-head">
        <h2 id="gallery-title">Z fotogalérie</h2>
        <a class="link-arrow" href={url('/obec/fotogaleria/')}>Všetky albumy <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="album-grid album-grid--4">
        {photos.map((a) => (
          <li class="album-card">
            <div class="album-cover album-cover--single"><img src={url(a.photos[0].thumb)} alt="" loading="lazy" decoding="async" /></div>
            <div class="album-body">
              <h3><a href={url(`/obec/fotogaleria/${a.id}-${a.slug}/`)}>{a.title}</a></h3>
              <p>{a.photos.length} fotografií</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="stefanik" aria-labelledby="stefanik-title">
    <div class="container stefanik-inner">
      <div>
        <h2 id="stefanik-title">Tu sa 4. mája 1919 skončil posledný let generála M. R. Štefánika</h2>
        <p>Lietadlo Caproni s generálom Milanom Rastislavom Štefánikom sa zrútilo pri návrate domov na okraji vtedajšej obce Bruck an der Donau, dnešného Mosta pri Bratislave. V severozápadnom cípe chotára obce dnes stojí mohyla, postavená v roku 1923 podľa návrhu architekta Dušana Jurkoviča.</p>
        <a class="link-arrow" href={url('/obec/historia/')}>Prečítajte si históriu obce <Icon name="arrow-right" size={18} /></a>
      </div>
      <svg class="flight" viewBox="0 0 520 260" role="img" aria-label="Ilustrácia: dráha letu, ktorá končí v Moste pri Bratislave">
        <defs>
          <linearGradient id="fl" x1="0" x2="1"><stop offset="0" stop-color="#f2dc86" stop-opacity="0" /><stop offset="1" stop-color="#f2dc86" /></linearGradient>
        </defs>
        <path d="M10 220 C 140 40, 300 20, 430 150" fill="none" stroke="url(#fl)" stroke-width="3" stroke-dasharray="2 10" stroke-linecap="round" />
        <g transform="translate(430 150)">
          <circle r="34" fill="#f2dc86" opacity="0.08" />
          <circle r="18" fill="#f2dc86" opacity="0.18" />
          <circle r="7" fill="#e3bd2f" />
        </g>
        <g transform="translate(372 78) rotate(38)" fill="#ffffff">
          <path d="M0 -4 L26 -2 Q32 0 26 2 L0 4 Z" />
          <path d="M10 -2 L4 -22 L9 -22 L18 -2 Z" />
          <path d="M10 2 L4 22 L9 22 L18 2 Z" />
          <path d="M1 -1 L-4 -9 L-1 -9 L4 -1 Z" />
          <path d="M1 1 L-4 9 L-1 9 L4 1 Z" />
        </g>
        <text x="430" y="205" text-anchor="middle" fill="#ffffff" font-family="inherit" font-size="15" font-weight="700">Most pri Bratislave</text>
        <text x="430" y="224" text-anchor="middle" fill="#b9c6e4" font-family="inherit" font-size="13">4. 5. 1919</text>
      </svg>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { sections, url } from '../data/site';
import { sectionTree } from '../lib/content';
const all = await Promise.all([...sections.map((s) => s.id), 'kontakt'].map(async (id) => ({ id, groups: await sectionTree(id) })));
const title = (id: string) => sections.find((s) => s.id === id)?.title ?? 'Kontakt';
---
<Base title="Mapa stránky">
  <div class="page-head"><div class="container"><Breadcrumbs items={[{ title: 'Mapa stránky' }]} /><h1>Mapa stránky</h1></div></div>
  <div class="container prose" style="padding-block: 32px 64px; max-width: none; columns: 300px 3; column-gap: 48px">
    {all.map(({ id, groups }) => (
      <section style="break-inside: avoid; margin-bottom: 24px">
        <h2 style="margin-top:0"><a href={url(`/${id}/`)}>{title(id)}</a></h2>
        <ul>
          {[...groups.values()].flat().map((top) => (
            <li><a href={url(top.href)}>{top.title}</a>
              {top.children.length > 0 && <ul>{top.children.map((c) => <li><a href={url(c.href)}>{c.title}</a></li>)}</ul>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

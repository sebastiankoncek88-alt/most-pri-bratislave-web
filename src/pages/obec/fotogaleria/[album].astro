---
import PageShell from '../../../layouts/PageShell.astro';
import Icon from '../../../components/Icon.astro';
import gallery from '../../../data/gallery.json';
import { url } from '../../../data/site';
import { fmtDate } from '../../../lib/content';
export function getStaticPaths() {
  return gallery.map((a) => ({ params: { album: `${a.id}-${a.slug}` }, props: { a } }));
}
const { a } = Astro.props;
const date = a.date ? fmtDate(new Date(a.date + 'T12:00:00'), { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---
<PageShell title={a.title} section="obec" href="/obec/fotogaleria/" lead={`${a.photos.length} fotografií${date ? ', ' + date : ''}`}
  crumbs={[{ title: 'Život v obci', href: '/obec/' }, { title: 'Fotogaléria', href: '/obec/fotogaleria/' }, { title: a.title }]}>
  <ul class="photo-grid" data-gallery>
    {a.photos.map((p, i) => (
      <li>
        <a href={url(p.src)} data-w={p.w} data-h={p.h} aria-label={`Fotografia ${i + 1} z ${a.photos.length}`}>
          <img src={url(p.thumb)} alt={`${a.title} – fotografia ${i + 1}`} loading={i < 12 ? 'eager' : 'lazy'} decoding="async" />
        </a>
      </li>
    ))}
  </ul>
  <p style="margin-top:24px"><a class="link-arrow" href={url('/obec/fotogaleria/')}><Icon name="arrow-left" size={18} /> Späť na všetky albumy</a></p>
  <dialog class="lightbox" aria-label="Prehliadanie fotografií">
    <img alt="" />
    <p class="lb-count" aria-live="polite"></p>
    <button class="lb-btn lb-close" type="button" aria-label="Zavrieť"><Icon name="x" size={28} /></button>
    <button class="lb-btn lb-prev" type="button" aria-label="Predchádzajúca fotografia"><Icon name="chevron-left" size={32} /></button>
    <button class="lb-btn lb-next" type="button" aria-label="Ďalšia fotografia"><Icon name="chevron-right" size={32} /></button>
  </dialog>
</PageShell>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-gallery] a')];
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dlg.querySelector('img')!;
  const cnt = dlg.querySelector('.lb-count')!;
  let i = 0;
  const show = (n: number) => {
    i = (n + links.length) % links.length;
    img.src = links[i].href;
    img.alt = links[i].querySelector('img')?.alt || '';
    cnt.textContent = `${i + 1} / ${links.length}`;
    new Image().src = links[(i + 1) % links.length].href; // prednačítanie ďalšej
  };
  links.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); show(n); dlg.showModal(); }));
  dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(i - 1));
  dlg.querySelector('.lb-next')!.addEventListener('click', () => show(i + 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(i + 1); if (e.key === 'ArrowLeft') show(i - 1); });
  let x0: number | null = null;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg.addEventListener('touchend', (e) => {
    if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1)); x0 = null;
  });
</script>

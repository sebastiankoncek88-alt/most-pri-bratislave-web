---
import PageShell from '../../../layouts/PageShell.astro';
import gallery from '../../../data/gallery.json';
import { url, schools } from '../../../data/site';
import Icon from '../../../components/Icon.astro';
import { fmtDate } from '../../../lib/content';
const count = (n: number) => `${n} ${n === 1 ? 'fotka' : n < 5 ? 'fotky' : 'fotiek'}`;
---
<PageShell title="Fotogaléria" section="obec" href="/obec/fotogaleria/" lead="Fotografie z Dňa obce, Mikuláša, súťaží, hasičských akcií a ďalších podujatí.">
  <ul class="album-grid">
    {gallery.map((a) => (
      <li class="album-card">
        <div class="album-cover">
          {a.photos.slice(0, 3).map((p, i) => <img src={url(p.thumb)} alt="" loading={i ? 'lazy' : 'eager'} decoding="async" />)}
        </div>
        <div class="album-body">
          <h2><a href={url(`/obec/fotogaleria/${a.id}-${a.slug}/`)}>{a.title}</a></h2>
          <p>{a.date && <time datetime={a.date}>{fmtDate(new Date(a.date + 'T12:00:00'), { day: 'numeric', month: 'long', year: 'numeric' })}</time>}{a.date ? ', ' : ''}{count(a.photos.length)}</p>
        </div>
      </li>
    ))}
  </ul>
  <section class="school-albums" aria-labelledby="skoly-title">
    <h2 id="skoly-title">Fotky zo škôl</h2>
    <p>Fotoalbumy z akcií škôl spravujú samotné školy na svojich weboch.</p>
    <ul class="school-grid">
      {schools.map((s) => (
        <li class="school-card">
          <span class="sc-ico" aria-hidden="true"><Icon name="school" size={28} /></span>
          <span class="sc-body">
            <strong>{s.name}</strong>
            <small>{s.address}</small>
            <span class="sc-links">
              <a href={s.album}>Fotoalbum <Icon name="external-link" size={15} /></a>
              <a href={s.web}>Web školy <Icon name="external-link" size={15} /></a>
            </span>
          </span>
        </li>
      ))}
    </ul>
  </section>
</PageShell>

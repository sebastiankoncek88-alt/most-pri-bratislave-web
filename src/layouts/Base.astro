---
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../data/site';
interface Props { title?: string; description?: string; current?: string; noindex?: boolean }
const { title, description = 'Oficiálna stránka obce Most pri Bratislave – úrad, odpady, samospráva, úradná tabuľa, aktuality a život v obci.', current, noindex } = Astro.props;
const fullTitle = title ? `${title} | Obec Most pri Bratislave` : 'Obec Most pri Bratislave';
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16295a" />
    <link rel="icon" type="image/png" href={url('/favicon.png?v=2')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png?v=2')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('/erb-512-v2.png'), Astro.site)} />
    <meta property="og:locale" content="sk_SK" />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      // režim zvolený návštevníkom sa nastaví ešte pred vykreslením (bez bliknutia)
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        var r = document.documentElement;
        if (t === 'light' || t === 'dark') r.dataset.theme = t;
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) r.classList.add('is-dark');
      })();
    </script>
  </head>
  <body>
    <Header current={current} />
    <main id="obsah" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
